# Puerto principal del portal (panel + API)
PORT=8080
# Puertos adicionales. 25461 es el de XtreamUI: así los clientes migrados no cambian su URL.
EXTRA_PORTS=25461
HOST=0.0.0.0
# true si está detrás de Nginx (para obtener la IP real del cliente)
TRUST_PROXY=true

# URL con la que los clientes llegan al portal (enlaces M3U, instalación de nodos). Si se deja vacía, en el primer arranque
# se usa la IP pública de las interfaces del servidor (nunca una IP local). Poner AUTO_PUBLIC_URL=false para desactivarlo.
PUBLIC_URL=
AUTO_PUBLIC_URL=true

# Contraseña del usuario "admin" creado en el primer arranque (si se omite se genera y se muestra en consola)
ADMIN_PASSWORD=
# Secreto para las sesiones del panel (si se omite se genera y se guarda en la base de datos)
JWT_SECRET=

# Base de datos: better-sqlite3 (por defecto), pg (PostgreSQL) o mysql2 (MySQL/MariaDB)
DB_CLIENT=better-sqlite3
DB_FILE=./data/iptv.db
# Para pg o mysql2:
# DATABASE_URL=postgres://iptv:clave@127.0.0.1:5432/iptv
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=iptv
# DB_PASSWORD=
# DB_NAME=iptv

# Copias de seguridad (por defecto server/data/backups)
# BACKUP_DIR=/ruta/a/backups

# Descubrimiento en red local para la app (UDP). Poner false para apagarlo.
# DISCOVERY_PORT=25460
# DISCOVERY_ENABLED=true
